<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The shader is compiled by Unity into an asset bundle (scripts/build-shaders.sh writes
    target/bundles/visuals) and embedded here, so the mod stays one DLL like every other mod.
  -->
  <PropertyGroup>
    <VisualsBundle>$(MSBuildThisFileDirectory)../../../target/bundles/visuals</VisualsBundle>
  </PropertyGroup>
  <ItemGroup>
    <GameRef Include="UnityEngine.AssetBundleModule" />
    <GameRef Include="UnityEngine.InputLegacyModule" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../ModSettings/ModSettings.csproj" Private="false" />
    <EmbeddedResource Include="$(VisualsBundle)" LogicalName="visuals.bundle" />
  </ItemGroup>
  <Target Name="CheckVisualsBundle" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(VisualsBundle)')" Text="Missing $(VisualsBundle). Run scripts/build-shaders.sh first (needs the Unity editor)." />
  </Target>
</Project>
